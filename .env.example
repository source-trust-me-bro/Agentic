# Model layer: "fake" runs offline with deterministic rules; "gemini" uses Google's API.
LLM_PROVIDER=fake
GEMINI_API_KEY=
# Fast (about 3 s per call). gemini-3-flash-preview is a slightly slower, stronger option.
GEMINI_MODEL=gemini-3.1-flash-lite
# low | medium | high. "minimal" is not supported by this model.
GEMINI_THINKING_LEVEL=low

# Alternative model: any OpenAI-compatible endpoint (set LLM_PROVIDER=huggingface).
HF_TOKEN=
HF_MODEL=deepseek-ai/DeepSeek-V4.1-Flash-1017:novita
HF_BASE_URL=https://router.huggingface.co/v1

# Leave empty to keep everything in memory. Set to persist to MongoDB.
MONGODB_URI=
MONGODB_DATABASE=agentic_newsroom

# Bounds that stop loops.
MAX_INVESTIGATION_ROUNDS=3
MAX_REVISION_ROUNDS=2
MAX_PITCHES_PER_CYCLE=3

# Agents run a cycle on their own every N minutes (0 = off). Real model only.
CYCLE_INTERVAL_MINUTES=0

# Require this key (X-Api-Key) on review and publishing endpoints. Real deployments need
# proper staff authentication in front of these routes.
API_KEY=

# Topic-graph integration with the application backend's REST API (docs/CONNECTOR.md).
# Empty BACKEND_API_URL keeps the connector passive: it runs no graph work at all.
BACKEND_API_URL=            # e.g. http://127.0.0.1:8000 (the client adds /api/v1)
BACKEND_API_TOKEN=          # bearer credential the backend accepts with the editor role
# Connector tuning: only ONE batched model call per run, after a free lexical shortlist.
CONNECTOR_USES_MODEL=false
CONNECTOR_PREFILTER_SCORE=0.12
CONNECTOR_MIN_SIMILARITY=0.34
CONNECTOR_MAX_CANDIDATES=20
